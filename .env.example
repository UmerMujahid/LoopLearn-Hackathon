# ===== FoodLoop Environment Variables =====

# MongoDB Atlas Connection String
# Replace <password> with your actual password
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.fwbwvpo.mongodb.net/foodLoop_db

# JWT Configuration
JWT_SECRET=<your-256-bit-secret>
JWT_EXPIRES_IN=24h

# Service Ports
PORT_GATEWAY=4000
PORT_AUTH=4001
PORT_CORE=4002
PORT_AI=5000

# Service URLs (localhost for dev, container names for Docker)
AUTH_SERVICE_URL=http://localhost:4001
CORE_SERVICE_URL=http://localhost:4002
AI_SERVICE_URL=http://localhost:5000

# Frontend
CLIENT_URL=http://localhost:5173

# AI Service (Python — FastAPI on :5000)
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=qwen/qwen3.6-27b
